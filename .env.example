# Frontend environment template — placeholders only, NEVER real secrets.
# Copy to .env for local development:  Copy-Item .env.example .env
# Local backend URL (no trailing slash):
VITE_API_URL=http://localhost:5001

# Production (set in Vercel Dashboard → Settings → Environment Variables, NOT in this file):
# VITE_API_URL=https://YOUR-BACKEND.onrender.com

# ── Security note ─────────────────────────────────────────────
# VITE_API_URL is intentionally public: it holds the backend base URL
# (not a secret) and MUST keep the VITE_ prefix so Vite exposes it to
# browser code via import.meta.env. Removing the prefix would make it
# undefined in the browser and break all API calls.
# Never add secrets here (API keys, JWT secrets, tokens, DB credentials)
# — keep them in the backend's server-side environment only.
# See backend/.env.example for server-side variables (GROQ_API_KEY, etc.).
